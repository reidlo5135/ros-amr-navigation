<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_viz</name>
  <version>0.4.0</version>
  <description>Desktop visualization bridge and Electron app scaffold for the ROS AMR navigation stack.</description>
  <maintainer email="reidlo4215@gmail.com">reidlo</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>amr_msgs</exec_depend>
  <exec_depend>amr_localization</exec_depend>
  <exec_depend>amr_global_planner</exec_depend>
  <exec_depend>amr_local_planner</exec_depend>
  <exec_depend>amr_motion_controller</exec_depend>
  <exec_depend>amr_obstacle_detection</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
