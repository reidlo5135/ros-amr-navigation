<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="turtlebot3_burger">
  <xacro:arg name="prefix" default=""/>

  <xacro:property name="base_length" value="0.138"/>
  <xacro:property name="base_width" value="0.178"/>
  <xacro:property name="base_height" value="0.080"/>
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.018"/>
  <xacro:property name="wheel_separation" value="0.160"/>
  <xacro:property name="base_z" value="${wheel_radius + (base_height * 0.5)}"/>
  <xacro:property name="wheel_y_offset" value="${wheel_separation * 0.5}"/>
  <xacro:property name="scan_x" value="0.032"/>
  <xacro:property name="scan_z" value="0.172"/>
  <xacro:property name="imu_z" value="0.068"/>

  <material name="base_color">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="wheel_color">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>
  <material name="sensor_color">
    <color rgba="0.85 0.35 0.10 1.0"/>
  </material>

  <link name="${prefix}base_footprint"/>

  <joint name="${prefix}base_footprint_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="base_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="${prefix}left_wheel_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}left_wheel_link"/>
    <origin xyz="0 ${wheel_y_offset} ${-base_height * 0.5}" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${prefix}left_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="${prefix}right_wheel_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}right_wheel_link"/>
    <origin xyz="0 ${-wheel_y_offset} ${-base_height * 0.5}" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${prefix}right_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="${prefix}caster_back_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}caster_back_link"/>
    <origin xyz="-0.045 0 ${-base_height * 0.5}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}caster_back_link">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="${prefix}base_scan_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}base_scan"/>
    <origin xyz="${scan_x} 0 ${scan_z}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}base_scan">
    <visual>
      <geometry>
        <cylinder radius="0.028" length="0.040"/>
      </geometry>
      <material name="sensor_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.028" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="${prefix}imu_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}imu_link"/>
    <origin xyz="0 0 ${imu_z}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}imu_link">
    <visual>
      <geometry>
        <box size="0.020 0.020 0.010"/>
      </geometry>
      <material name="sensor_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.020 0.020 0.010"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>
</robot>
