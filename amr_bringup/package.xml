<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bringup</name>
  <version>0.19.4</version>
  <description>Launch and runtime assets for the ROS AMR navigation stack.</description>
  <maintainer email="reidlo4215@gmail.com">reidlo</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>amr_costmap_server</exec_depend>
  <exec_depend>amr_global_planner</exec_depend>
  <exec_depend>amr_controller_server</exec_depend>
  <exec_depend>amr_recovery_server</exec_depend>
  <exec_depend>amr_bt_navigator</exec_depend>
  <exec_depend>amr_frontier_navigator</exec_depend>
  <exec_depend>amr_lifecycle_manager</exec_depend>
  <exec_depend>amr_runtime_observation</exec_depend>
  <exec_depend>amr_mqtt_server</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
